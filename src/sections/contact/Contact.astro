---
import { PUBLIC_CONTACT_ENDPOINT } from "astro:env/client";
import type { Copy } from "@/content";
import { SITE } from "@/shared/config/site";
import Button from "@/shared/ui/Button.astro";
import Icon from "@/shared/ui/Icon.astro";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const contact = copy.contact;

/**
 * Sin endpoint configurado el formulario abre el cliente de correo. Es el
 * modo por defecto a proposito: el sitio no depende de un servicio de
 * terceros para funcionar el dia uno. Ver `.env.example`.
 */
const endpoint = PUBLIC_CONTACT_ENDPOINT ?? "";
---

<section id="contacto" class="section" aria-labelledby="contact-title">
  <div class="page layout">
    <div class="intro">
      <p class="mono index">06 / contact</p>
      <h2 id="contact-title" class="title">{contact.title}</h2>
      <p class="sub">{contact.sub}</p>

      <ul class="direct">
        <li>
          <a class="direct-link" href={`mailto:${SITE.email}`}>
            <Icon name="mail" size={18} />
            {SITE.email}
          </a>
        </li>
        {
          SITE.linkedin && (
            <li>
              <a class="direct-link" href={SITE.linkedin} rel="noopener" target="_blank">
                <Icon name="linkedin" size={18} />
                LinkedIn
                <Icon name="arrow-up-right" size={14} />
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <form
      class="form"
      data-contact-form
      data-endpoint={endpoint}
      data-email={SITE.email}
      data-text-idle={contact.submit}
      data-text-sending={contact.sending}
      data-text-sent={contact.sent}
      data-text-failed={contact.failed}
      novalidate
    >
      <div class="field">
        <label class="label" for="contact-name">{contact.fieldName}</label>
        <input class="input" id="contact-name" name="name" type="text" required autocomplete="name" />
      </div>

      <div class="field">
        <label class="label" for="contact-email">{contact.fieldEmail}</label>
        <input
          class="input"
          id="contact-email"
          name="email"
          type="email"
          required
          autocomplete="email"
        />
      </div>

      <div class="field">
        <label class="label" for="contact-message">{contact.fieldMessage}</label>
        <textarea
          class="input textarea"
          id="contact-message"
          name="message"
          rows="5"
          required
          placeholder={contact.placeholderMessage}></textarea>
      </div>

      <Button type="submit" class="submit" data-submit>{contact.submit}</Button>

      <p class="status" data-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const button = form.querySelector<HTMLButtonElement>("[data-submit]");
    const status = form.querySelector<HTMLParagraphElement>("[data-status]");
    const endpoint = form.dataset.endpoint ?? "";
    const email = form.dataset.email ?? "";

    const say = (message: string, tone: "ok" | "error" | "") => {
      if (!status) return;
      status.textContent = message;
      status.dataset.tone = tone;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const name = String(data.get("name") ?? "");
      const message = String(data.get("message") ?? "");
      const from = String(data.get("email") ?? "");

      // Sin endpoint: se arma el correo y lo manda el cliente de la persona.
      if (!endpoint) {
        const subject = encodeURIComponent(`Proyecto — ${name}`);
        const body = encodeURIComponent(`${message}\n\n${name}\n${from}`);
        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
        return;
      }

      button?.setAttribute("disabled", "");
      if (button) button.textContent = form.dataset.textSending ?? "";
      say("", "");

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: data,
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        say(form.dataset.textSent ?? "", "ok");
      } catch {
        say(`${form.dataset.textFailed ?? ""} ${email}`, "error");
      } finally {
        button?.removeAttribute("disabled");
        if (button) button.textContent = form.dataset.textIdle ?? "";
      }
    });
  }
</script>

<style>
  .section {
    padding-block: var(--section-gap);
    border-top: 1px solid var(--border-soft);
  }

  .layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-12);
    align-items: start;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .index {
    color: var(--accent);
    text-transform: uppercase;
  }

  .title {
    max-width: 18ch;
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .sub {
    max-width: 52ch;
    color: var(--text-muted);
  }

  .direct {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding-top: var(--space-4);
    list-style: none;
  }

  .direct-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    font-size: var(--text-sm);
  }

  .direct-link:hover {
    color: var(--accent);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .label {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .input {
    width: 100%;
    min-height: 44px;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--text);
    font-size: var(--text-sm);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .input:hover {
    border-color: var(--text-dim);
  }

  .input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .textarea {
    resize: vertical;
    line-height: 1.6;
  }

  .status:empty {
    display: none;
  }

  .status {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .status[data-tone="ok"] {
    color: var(--accent);
  }

  .status[data-tone="error"] {
    color: var(--state-building);
  }
</style>
