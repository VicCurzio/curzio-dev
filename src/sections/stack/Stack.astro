---
import type { Copy } from "@/content";
import SectionHeader from "@/shared/ui/SectionHeader.astro";
import Tag from "@/shared/ui/Tag.astro";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const stack = copy.stack;
---

<section id="stack" class="section" aria-labelledby="stack-title">
  <div class="page stack-layout">
    <SectionHeader index="04 / stack" id="stack-title" title={stack.title} sub={stack.sub} />

    <div class="groups">
      {
        stack.groups.map((group) => (
          <div class="group">
            <h3 class="mono group-name">{group.name}</h3>
            <ul class="items">
              {group.items.map((item) => (
                <li>
                  <Tag>{item}</Tag>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-gap);
  }

  .stack-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-8);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .group-name {
    color: var(--text-dim);
    text-transform: uppercase;
    font-weight: 500;
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
