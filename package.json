{
  "name": "curzio-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio comercial de Victor R. Curzio, desarrollador full stack freelance.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . && node scripts/check-layers.mjs",
    "format": "prettier --write .",
    "og": "node scripts/build-og.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^5.6.0",
    "@astrojs/sitemap": "^3.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.8.0",
    "eslint": "^9.23.0",
    "typescript-eslint": "^8.28.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-import-resolver-typescript": "^4.2.0",
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0"
  },
  "lint-staged": {
    "*.{ts,astro,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,astro,mjs,css,md,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.11"
  }
}
