---
/**
 * Chip de dato tecnico o de estado. Sin margin: la separacion la decide el
 * contenedor con `gap`.
 */
interface Props {
  /** Deja el chip en color neutro, o lo pinta con un token de estado. */
  tone?: "neutral" | "live" | "shipped" | "building";
  class?: string;
}

const { tone = "neutral", class: className } = Astro.props;
---

<span class:list={["tag", `tone-${tone}`, className]}><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    white-space: nowrap;
  }

  .tone-live {
    border-color: color-mix(in oklab, var(--state-live) 35%, transparent);
    background: color-mix(in oklab, var(--state-live) 12%, transparent);
    color: var(--state-live);
  }

  .tone-shipped {
    border-color: color-mix(in oklab, var(--state-shipped) 35%, transparent);
    background: color-mix(in oklab, var(--state-shipped) 12%, transparent);
    color: var(--state-shipped);
  }

  .tone-building {
    border-color: color-mix(in oklab, var(--state-building) 35%, transparent);
    background: color-mix(in oklab, var(--state-building) 12%, transparent);
    color: var(--state-building);
  }
</style>
